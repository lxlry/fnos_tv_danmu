<?xml version="1.0" encoding="utf-8"?>
<!-- Tab 按钮选择器 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 选中+聚焦：亮边框，明显区分 -->
    <item android:state_selected="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_button_normal" />
            <stroke android:width="2dp" android:color="#FF81C784" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_button_normal" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_input" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="@color/border_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
