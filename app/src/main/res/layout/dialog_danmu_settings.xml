<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF1A1A1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="弹幕设置"
                android:textColor="#FFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/dm_settings_reset"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_text_action"
                android:clickable="true"
                android:contentDescription="重置"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="10dp"
            android:background="#33FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="弹幕开关"
                    android:textColor="#EEE" />

                <Switch
                    android:id="@+id/dm_sw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true" />
            </LinearLayout>

            <include
                android:id="@+id/dm_area"
                layout="@layout/item_danmu_slider" />

            <include
                android:id="@+id/dm_speed"
                layout="@layout/item_danmu_slider" />

            <include
                android:id="@+id/dm_opacity"
                layout="@layout/item_danmu_slider" />

            <include
                android:id="@+id/dm_fontsize"
                layout="@layout/item_danmu_slider" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <Button
                android:id="@+id/dm_matchBtn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip"
                android:focusable="true"
                android:text="手动匹配弹幕"
                android:textColor="#FFF" />

            <Button
                android:id="@+id/dm_listBtn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip"
                android:focusable="true"
                android:text="弹幕列表"
                android:textColor="#FFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="滚动弹幕"
                    android:textColor="#CCC"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/dm_show_scroll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="顶部弹幕"
                    android:textColor="#CCC"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/dm_show_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="底部弹幕"
                    android:textColor="#CCC"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/dm_show_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="时间比例缩放"
                    android:textColor="#EEE" />

                <Switch
                    android:id="@+id/dm_time_scale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:nextFocusDown="@+id/dm_outline"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:text="文字描边"
                android:textColor="#EEE" />

            <Switch
                android:id="@+id/dm_outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@+id/dm_density"
                android:nextFocusUp="@+id/dm_outline" />

            <include
                android:id="@+id/dm_density"
                layout="@layout/item_danmu_slider" />

            <include
                android:id="@+id/dm_maxactive"
                layout="@layout/item_danmu_slider" />

            <include
                android:id="@+id/dm_rowspacing"
                layout="@layout/item_danmu_slider" />

            <include
                android:id="@+id/dm_offset"
                layout="@layout/item_danmu_slider" />

            <include
                android:id="@+id/dm_maxcomments"
                layout="@layout/item_danmu_slider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:nextFocusDown="@+id/dm_custom_fps"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="自定义刷新率"
                android:textColor="#EEE" />

            <Switch
                android:id="@+id/dm_custom_fps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@+id/dm_fps"
                android:nextFocusUp="@+id/dm_custom_fps" />

            <include
                android:id="@+id/dm_fps"
                layout="@layout/item_danmu_slider" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
