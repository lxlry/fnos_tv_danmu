<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 视频 -->
    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
 />

    <!-- 缓冲 -->
    <com.fntv.app.WaveTextView
        android:id="@+id/tvBuffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="加载中..."
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:forceDarkAllowed="false"
        android:visibility="gone" />

    <!-- 弹幕层（视频上方，控件下方） -->
    <com.fntv.app.DanmuView
        android:id="@+id/danmuView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 顶部返回 + 标题，必须盖在弹幕上面，否则弹幕会抢走点击 -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_player_top"
        android:elevation="8dp"
        android:minHeight="52dp"
        android:paddingBottom="8dp"
        android:visibility="invisible">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginLeft="4dp"
            android:background="@drawable/bg_player_action"
            android:clickable="true"
            android:contentDescription="返回"
            android:focusable="true"
            android:nextFocusDown="@+id/seekBar"
            android:nextFocusRight="@+id/btnMore"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_back" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentTop="true"
            android:layout_marginRight="6dp"
            android:background="@drawable/bg_player_action"
            android:clickable="true"
            android:contentDescription="更多"
            android:focusable="true"
            android:nextFocusDown="@+id/btnLock"
            android:nextFocusLeft="@+id/btnBack"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_more" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/btnBack"
            android:layout_alignBottom="@id/btnBack"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="4dp"
            android:layout_toLeftOf="@id/btnMore"
            android:layout_toRightOf="@id/btnBack"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text=""
                android:textColor="#FFF"
                android:textSize="15sp" />

            <TextView android:id="@+id/tvDanmuMatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:ellipsize="end"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center_vertical"
                android:maxWidth="220dp"
                android:singleLine="true"
                android:text=""
                android:textColor="#FF81C784"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 弹幕状态提示（覆盖在视频上） -->
    <TextView
        android:id="@+id/tvDanmuStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_danmu_status"
        android:forceDarkAllowed="false"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="#FFF"
        android:textSize="13sp"
        android:visibility="gone"
        android:maxWidth="420dp"
        android:maxLines="3"
        android:ellipsize="end" />

    <!-- 长按倍速提示 -->
    <TextView
        android:id="@+id/tvSpeedHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_danmu_status_hint"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="倍速播放中"
        android:textColor="#FFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- 锁定按钮（右侧中间） -->
    <ImageView android:id="@+id/btnLock"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical|right"
        android:layout_marginRight="8dp"
        android:background="@drawable/bg_chip"
        android:elevation="8dp"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:src="@drawable/ic_unlock"
        android:focusable="true"
            android:nextFocusDown="@+id/seekBar"
            android:nextFocusUp="@+id/btnMore"
        android:visibility="invisible" />

    <!-- 控制层 (底部深色渐变区) -->
    <LinearLayout
        android:id="@+id/controller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingBottom="6dp"
        android:background="@drawable/bg_controller"
        android:visibility="invisible">

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="00:00/00:00"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp" />

        <!-- 进度条 (细条)，上面叠片头片尾小竖线 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progress="0"
                android:focusable="true"
                android:nextFocusUp="@+id/btnBack"
                android:nextFocusDown="@+id/btnPlayPause"
                android:background="@drawable/seekbar_bg_focus"
                android:progressDrawable="@drawable/seeker_progress"
                android:thumb="@drawable/seeker_thumb"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="2dp" />

            <com.fntv.app.SkipSeekMarks
                android:id="@+id/skipMarks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:focusable="false"
                android:forceDarkAllowed="false" />
        </FrameLayout>

        <!-- 左：暂停 / 下一集。右：选集、倍速、音频、字幕、原画，片头尾留在栏上 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="6dp"
            android:paddingRight="8dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_player_action"
                android:clickable="true"
                android:contentDescription="暂停"
                android:focusable="true"
                android:nextFocusUp="@+id/seekBar"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_pause" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnNextEp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginLeft="4dp"
                android:background="@drawable/bg_player_action"
                android:clickable="true"
                android:contentDescription="下一集"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_next"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button android:id="@+id/btnEpisodeList"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_player_action"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="选集"
                android:textColor="#FFF"
                android:textSize="16sp"
                android:visibility="gone" />

            <Button android:id="@+id/btnSkip"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_player_action"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="片头尾"
                android:textColor="#FFF"
                android:textSize="16sp" />

            <Button android:id="@+id/btnDanmu"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_player_action"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="弹幕"
                android:textAllCaps="false"
                android:textColor="#FFF"
                android:textSize="16sp" />

            <Button android:id="@+id/btnSpeed"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_player_action"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="1X"
                android:textColor="#FFF"
                android:textSize="16sp" />

            <Button android:id="@+id/btnAudioTrack"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_player_action"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="音频"
                android:textColor="#FFF"
                android:textSize="16sp" />

            <Button android:id="@+id/btnSubtitleTrack"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_player_action"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="字幕"
                android:textColor="#FFF"
                android:textSize="16sp" />

            <Button android:id="@+id/btnQuality"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_player_action"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="原画"
                android:textColor="#FFF"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 信息面板 -->
    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#DD000000"
        android:padding="16dp"
        android:clickable="true"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/infoText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="#FFF"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/infoTextAudio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="#DDD"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/infoTextExtra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text=""
                    android:textColor="#999"
                    android:textSize="11sp" />

            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:id="@+id/trackBtnRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp">

            <Button android:id="@+id/btnHdrToggle"
                android:layout_width="wrap_content" android:layout_height="34dp"
                android:background="@drawable/bg_chip"
                android:text="HDR"
                android:textColor="#EEE" android:textSize="12sp"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="10dp" android:paddingRight="10dp"
                android:minWidth="0dp" android:minHeight="0dp"
                android:layout_marginRight="6dp"
                android:nextFocusDown="@+id/btnCloseInfo" />

        </LinearLayout>

        <Button
            android:id="@+id/btnCloseInfo"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_chip"

            android:text="关闭"
            android:textColor="#FFF"
            android:focusable="true"
            android:layout_marginTop="8dp"
            android:nextFocusUp="@+id/btnHdrToggle" />
    </LinearLayout>

    <!-- 右上角三个点：图 1 主栏没有的功能。片头尾不放进来。 -->
    <FrameLayout
        android:id="@+id/moreScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:elevation="20dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/morePanel"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#F0121212"
            android:clickable="true"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="18dp"
            android:paddingRight="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="设置"
                android:textColor="#FFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="8dp"
                android:background="#33FFFFFF" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnSleep"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_player_action"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingLeft="8dp"
                        android:text="定时关闭"
                        android:textAllCaps="false"
                        android:textColor="#FFF"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btnCloudMode"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_player_action"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingLeft="8dp"
                        android:text="直链"
                        android:textAllCaps="false"
                        android:textColor="#81C784"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnInfo"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_player_action"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingLeft="8dp"
                        android:text="播放信息"
                        android:textAllCaps="false"
                        android:textColor="#FFF"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btnBrightness"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_player_action"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingLeft="8dp"
                        android:text="亮度"
                        android:textAllCaps="false"
                        android:textColor="#FFF"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btnHdrRow"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_player_action"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingLeft="8dp"
                        android:text="HDR"
                        android:textAllCaps="false"
                        android:textColor="#FFF"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="8dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="8dp"
                        android:text="画面比例"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnRatioFit"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginRight="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ratio_chip"
                            android:focusable="true"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="适应"
                            android:textAllCaps="false"
                            android:textColor="#FFF"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnRatioFill"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginRight="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ratio_chip"
                            android:focusable="true"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="填充"
                            android:textAllCaps="false"
                            android:textColor="#FFF"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnRatio43"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginRight="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ratio_chip"
                            android:focusable="true"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="4:3"
                            android:textAllCaps="false"
                            android:textColor="#FFF"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnRatio169"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginRight="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ratio_chip"
                            android:focusable="true"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="16:9"
                            android:textAllCaps="false"
                            android:textColor="#FFF"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnRatio219"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ratio_chip"
                            android:focusable="true"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="21:9"
                            android:textAllCaps="false"
                            android:textColor="#FFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/episodePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="24dp"
        android:visibility="gone" />

</FrameLayout>
