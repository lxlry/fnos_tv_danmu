<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/epScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000" />

    <LinearLayout
        android:id="@+id/epSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_episode_tv_fade"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingTop="36dp"
        android:paddingRight="28dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_episode_tab"
            android:paddingLeft="16dp"
            android:paddingTop="6dp"
            android:paddingRight="16dp"
            android:paddingBottom="6dp"
            android:text="选集"
            android:textColor="#FF121418"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:id="@+id/epRangeScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/epRangeBar"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_episode_range_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="4dp"
                android:paddingRight="4dp" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/epListScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/epList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="4dp" />
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
